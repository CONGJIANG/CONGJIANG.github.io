# Generate sample data (mixture of two Gaussians)
set.seed(123)
data <- c(rnorm(500, mean = 0, sd = 1), rnorm(500, mean = 5, sd = 1.5))
data
# Perform KDE
kde_est <- density(data, bw = "nrd0", kernel = "gaussian") # Silverman's rule for bandwidth
# True density (for comparison)
true_dens <- function(x) {
0.5 * dnorm(x, mean = 0, sd = 1) + 0.5 * dnorm(x, mean = 5, sd = 1.5)
}
# Plot
plot(kde_est, main = "Kernel Density Estimation", col = "blue", lwd = 2, xlab = "x")
curve(true_dens, add = TRUE, col = "red", lty = 2, lwd = 2)
legend("topright", legend = c("KDE Estimate", "True Density"),
col = c("blue", "red"), lty = c(1, 2), lwd = 2)
# Generate Laplace-distributed data
set.seed(123)
mu_true <- 2
sigma_true <- 1.5
data <- mu_true + sigma_true * rexp(1000) * sample(c(-1, 1), 1000, replace = TRUE)
# Estimate location (median) and scale (MAD)
mu_hat <- median(data)
sigma_hat <- mean(abs(data - mu_hat))
# Standardize data
Z <- (data - mu_hat) / sigma_hat
# KDE on standardized data
kde_Z <- density(Z, bw = "nrd0", kernel = "gaussian")
# Transform back to original scale
kde_original <- function(x) {
z <- (x - mu_hat) / sigma_hat
approx(kde_Z$x, kde_Z$y, xout = z)$y / sigma_hat
}
# True Laplace density
true_dens <- function(x) {
(1 / (2 * sigma_true)) * exp(-abs(x - mu_true) / sigma_true)
}
# Plot
x_grid <- seq(min(data) - 2, max(data) + 2, length.out = 500)
hist(data, breaks = 30, freq = FALSE, main = "Location-Scale KDE (Laplace)",
xlab = "x", col = "lightgray", border = "gray")
lines(x_grid, sapply(x_grid, kde_original), col = "blue", lwd = 2)
lines(x_grid, true_dens(x_grid), col = "red", lty = 2, lwd = 2)
legend("topright", legend = c("KDE Estimate", "True Density"),
col = c("blue", "red"), lty = c(1, 2), lwd = 2)
rexp(1000)
sample(c(-1, 1), 1000, replace = TRUE)
kde_Z <- density(Z, bw = "nrd0", kernel = "gaussian")
kde_Z
true_dens
