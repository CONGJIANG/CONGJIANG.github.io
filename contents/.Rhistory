library(hal9001)
?fit_hal
library(hal9001)
# Simulated data
set.seed(123)
n <- 100
X <- data.frame(X1 = runif(n), X2 = runif(n))
Y <- with(X, 3 * X1 + 2 * X2 + X1 * X2 + rnorm(n))
# Fit HAL model with max_degree = 2 (allowing up to 2-way interactions)
hal_fit <- fit_hal(X = X, Y = Y, max_degree = 2)
# View the model summary
summary(hal_fit)
hal_fit
